{
  "name": "voniweb-cold-email-engine",
  "version": "1.0.0",
  "description": "Self-contained cold email orchestration engine and local CRM dashboard for Voniweb",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build:css && concurrently -k -n css,server \"npm:watch:css\" \"npm:watch:server\"",
    "watch:css": "tailwindcss -i frontend/tailwind-input.css -o frontend/tailwind.css --watch",
    "watch:server": "tsx watch backend/src/index.ts",
    "start": "npm run build:css && tsx backend/src/index.ts",
    "build": "npm run build:css && tsc -p tsconfig.json",
    "build:css": "tailwindcss -i frontend/tailwind-input.css -o frontend/tailwind.css --minify",
    "import-leads": "tsx scripts/import-leads.ts",
    "reset-db": "tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16",
    "playwright": "^1.48.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.2.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
