# ============================================================
# VONIWEB COLD EMAIL ORCHESTRATION ENGINE - environment config
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ============================================================

# --- Server ---
PORT=3000

# --- Anthropic / Claude ---
# Used for: website audit reasoning, PAS email copywriting, reply triage classification.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Defaults to the latest Claude model. Override if you need a specific pinned version.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Campaign identity (used inside generated emails) ---
AGENCY_NAME=Voniweb
SENDER_NAME=Jalal Beqqal
SENDER_TITLE=Founder, Voniweb
AGENCY_LOCATION=Fes, Morocco
BOOKING_LINK=https://cal.com/voniweb/15min

# --- Campaign pacing / limits ---
DAILY_EMAIL_TARGET=500
MAX_EMAILS_PER_SMTP_PER_DAY=40
MIN_SEND_DELAY_MS=30000
MAX_SEND_DELAY_MS=90000
# How often (ms) each worker loop wakes up to check for work
WORKER_TICK_MS=5000
# How often (ms) the reply-triage worker polls IMAP inboxes
REPLY_POLL_MS=120000

# Optional: point the web auditor at a system-installed Chromium binary
# instead of Playwright's own downloaded browser (useful in locked-down or
# offline environments where `npx playwright install` can't reach the CDN).
# PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium

# --- SMTP account rotation ---
# Add up to 15 accounts (SMTP_1 .. SMTP_15). Each account can double as the
# IMAP account used to fetch replies sent to that same inbox. Leave a slot
# entirely blank/unset to skip it - the engine auto-detects how many are configured.
#
# Example for account #1 (Gmail-style, same mailbox for send + receive):
# SMTP_1_HOST=smtp.gmail.com
# SMTP_1_PORT=587
# SMTP_1_SECURE=false
# SMTP_1_USER=inbox1@voniweb.com
# SMTP_1_PASS=app-password-1
# SMTP_1_FROM_NAME=Jalal Beqqal
# SMTP_1_FROM_EMAIL=inbox1@voniweb.com
# SMTP_1_IMAP_HOST=imap.gmail.com
# SMTP_1_IMAP_PORT=993

SMTP_1_HOST=
SMTP_1_PORT=587
SMTP_1_SECURE=false
SMTP_1_USER=
SMTP_1_PASS=
SMTP_1_FROM_NAME=Jalal Beqqal
SMTP_1_FROM_EMAIL=
SMTP_1_IMAP_HOST=
SMTP_1_IMAP_PORT=993

